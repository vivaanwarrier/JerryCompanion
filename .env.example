# Used only by the serverless function in api/agent.js - never exposed to the browser.
# If unset, the mood agent falls back to deterministic rules (src/lib/rules.js),
# which is fine for local UI work but not the real thing.
ANTHROPIC_API_KEY=

# Optional overrides:
# ANTHROPIC_MODEL=claude-opus-5      # default; try claude-haiku-4-5 to cut cost/latency
# ANTHROPIC_EFFORT=low               # low | medium | high  (higher = slower, pricier)

# Optional: dev server port (default 3000)
# PORT=3000
